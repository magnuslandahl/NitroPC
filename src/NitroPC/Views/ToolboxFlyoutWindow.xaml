<Window x:Class="NitroPC.Views.ToolboxFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NitroPC.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="688"
        SizeToContent="Height">
    <Border x:Name="RootBorder"
            HorizontalAlignment="Left"
            Margin="8"
            Padding="16"
            Background="{StaticResource FlyoutBackgroundBrush}"
            BorderBrush="{StaticResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Direction="270" Opacity="0.48" ShadowDepth="8" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="336"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="BrandHeader" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF3A683" Offset="0"/>
                                    <GradientStop Color="#FF6EC6FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="N"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="12"
                                       FontWeight="ExtraBold"
                                       Foreground="#FF0E1920"/>
                        </Border>
                        <TextBlock Text="NitroPC"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Margin="6,0,0,0"
                                Padding="5,1.5"
                                VerticalAlignment="Center"
                                CornerRadius="4"
                                Background="#12FFFFFF"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1">
                            <TextBlock x:Name="HeaderVersionText"
                                       Text="v0.1.0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border x:Name="StatusChip"
                            Grid.Column="1"
                            Height="28"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            CornerRadius="7"
                            Background="{StaticResource KaffeGlowFillBrush}"
                            BorderBrush="{StaticResource KaffeGlowBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="6"
                                     Height="6"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource KaffeAmberBrush}"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Awake"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource KaffeLabelAwakeBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Margin="6,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            ToolTip="Settings"
                            Style="{StaticResource NitroButton}"
                            Click="OnSettingsToggle">
                        <Viewbox Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="SettingsGearRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="9"
                                         Canvas.Top="9"
                                         Width="6"
                                         Height="6"
                                         Stroke="{StaticResource TextMutedBrush}"
                                         StrokeThickness="2"/>
                                <Path x:Name="SettingsIconPath"
                                      Data="M 19.4,15 A 1.65,1.65 0 0 0 19.73,16.82 L 19.79,16.88 A 2,2 0 1 1 16.96,19.71 L 16.9,19.65 A 1.65,1.65 0 0 0 15.08,19.32 A 1.65,1.65 0 0 0 14,20.83 V 21 A 2,2 0 1 1 10,21 V 20.91 A 1.65,1.65 0 0 0 8.92,19.4 A 1.65,1.65 0 0 0 7.1,19.73 L 7.04,19.79 A 2,2 0 1 1 4.21,16.96 L 4.27,16.9 A 1.65,1.65 0 0 0 4.6,15.08 A 1.65,1.65 0 0 0 3.09,14 H 3 A 2,2 0 1 1 3,10 H 3.09 A 1.65,1.65 0 0 0 4.6,8.92 A 1.65,1.65 0 0 0 4.27,7.1 L 4.21,7.04 A 2,2 0 1 1 7.04,4.21 L 7.1,4.27 A 1.65,1.65 0 0 0 8.92,4.6 H 9 A 1.65,1.65 0 0 0 10,3.09 V 3 A 2,2 0 1 1 14,3 V 3.09 A 1.65,1.65 0 0 0 15,4.6 A 1.65,1.65 0 0 0 16.82,4.27 L 16.88,4.21 A 2,2 0 1 1 19.71,7.04 L 19.65,7.1 A 1.65,1.65 0 0 0 19.32,8.92 V 9 A 1.65,1.65 0 0 0 20.83,10 H 21 A 2,2 0 1 1 21,14 H 20.91 A 1.65,1.65 0 0 0 19.4,15 Z"
                                      Stroke="{StaticResource TextMutedBrush}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel x:Name="MainViewPanel">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="11,10"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU LOAD"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="CpuLargeValue"
                                           HorizontalAlignment="Right"
                                           Text="0%"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{StaticResource CpuCoralBrush}"/>
                            </Grid>
                            <TextBlock x:Name="CpuSensorsText"
                                       Margin="0,2,0,0"
                                       Text="— GHz · —°C"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <controls:CpuBarsControl x:Name="CpuLargeBars"
                                                      Height="26"
                                                      Margin="0,6,0,0"
                                                      MaxBars="30"
                                                      BarBrush="{StaticResource CpuCoralBrush}"
                                                      LatestBarBrush="{StaticResource CpuLatestBrush}"/>
                            <TextBlock x:Name="CpuCoresText"
                                       Margin="0,6,0,0"
                                       Text="60-second history"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="11,10"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="MEMORY"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="RamLargeValue"
                                           HorizontalAlignment="Right"
                                           Text="0%"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{StaticResource RamBlueBrush}"/>
                            </Grid>
                            <TextBlock x:Name="RamUsageText"
                                       Margin="0,2,0,0"
                                       Text="0.0 / 0.0 GB"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <controls:RamSparklineControl x:Name="RamLargeSparkline"
                                                           Height="26"
                                                           Margin="0,6,0,0"
                                                           MaxSamples="30"
                                                           StrokeBrush="{StaticResource RamBlueBrush}"
                                                           FillBrush="{StaticResource RamFillBrush}"
                                                           GuideBrush="{StaticResource SparkGuideBrush}"
                                                           LatestPointBrush="{StaticResource RamLatestBrush}"/>
                            <TextBlock x:Name="RamDetailText"
                                       Margin="0,6,0,0"
                                       Text="60-second history"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="10"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,10,0,0"
                        Padding="12,9"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TOP CPU PROCESSES"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="CPU"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <TextBlock x:Name="TopProcessesEmptyText"
                                   Margin="0,6,0,2"
                                   Text="Sampling active processes…"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel x:Name="TopProcessesPanel" Margin="0,5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border x:Name="KeepAwakeCard"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 17,8 H 18 A 4,4 0 1 1 18,16 H 17 M 3,8 H 17 V 17 A 4,4 0 0 1 13,21 H 7 A 4,4 0 0 1 3,17 Z M 6,2 V 4 M 10,2 V 4 M 14,2 V 4"
                                                  Stroke="{StaticResource KaffeAmberBrush}"
                                                  StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Keep Awake"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource NitroFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="KeepAwakeDetailText"
                                           Margin="0,3,0,0"
                                           Text="Off — normal sleep &amp; screen lock"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button x:Name="KeepAwakeButton"
                                    Grid.Column="1"
                                    MinWidth="58"
                                    VerticalAlignment="Center"
                                    Content="Start"
                                    Style="{StaticResource NitroButton}"
                                    Click="OnToggleKeepAwake"/>
                        </Grid>

                        <UniformGrid Margin="0,10,0,0" Columns="5">
                            <Button x:Name="Preset1hButton" Content="1h" Margin="0,0,4,0" Tag="60" Style="{StaticResource NitroChip}" Click="OnPresetClicked"/>
                            <Button x:Name="Preset2hButton" Content="2h" Margin="2,0,2,0" Tag="120" Style="{StaticResource NitroChip}" Click="OnPresetClicked"/>
                            <Button x:Name="Preset4hButton" Content="4h" Margin="2,0,2,0" Tag="240" Style="{StaticResource NitroChip}" Click="OnPresetClicked"/>
                            <Button x:Name="Preset8hButton" Content="8h" Margin="2,0,2,0" Tag="480" Style="{StaticResource NitroChip}" Click="OnPresetClicked"/>
                            <Button x:Name="PresetInfiniteButton" Content="∞" Margin="4,0,0,0" Tag="0" ToolTip="Infinite — keep awake until stopped" Style="{StaticResource NitroChip}" Click="OnPresetClicked"/>
                        </UniformGrid>

                        <ProgressBar x:Name="KeepAwakeProgress"
                                     Height="3"
                                     Margin="0,9,0,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     BorderThickness="0"
                                     Foreground="{StaticResource KaffeAmberBrush}"
                                     Background="#14FFFFFF"/>
                    </StackPanel>
                </Border>

                <Border x:Name="QuietModeCard"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 21,12.79 A 9,9 0 1 1 11.21,3 A 7,7 0 0 0 21,12.79 Z"
                                              Stroke="{StaticResource RamBlueBrush}"
                                              StrokeThickness="2.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Quiet Mode"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="QuietOffButton" Content="Off" Tag="Off" Style="{StaticResource NitroChip}" Click="OnQuietModeClicked"/>
                                <Button x:Name="QuietAutoButton" Margin="4,0,0,0" Content="Auto" Tag="Auto" ToolTip="Disables CPU boost automatically when hot, then restores it once cooled" Style="{StaticResource NitroChip}" Click="OnQuietModeClicked"/>
                                <Button x:Name="QuietAlwaysButton" Margin="4,0,0,0" Content="Quiet" Tag="Quiet" ToolTip="Always disables CPU turbo boost while active" Style="{StaticResource NitroChip}" Click="OnQuietModeClicked"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="QuietModeDetailText"
                                   Margin="0,5,0,0"
                                   Text="Normal CPU boost — full peak clock speed"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>

            <Border x:Name="SettingsDrawer"
                    Grid.Column="1"
                    Width="0"
                    ClipToBounds="True">
                <Grid x:Name="SettingsDrawerContent"
                      Width="300"
                      Opacity="0"
                      HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="33"/>
                        <ColumnDefinition Width="267"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="1"
                            Margin="16,0,16,0"
                            Background="{StaticResource DividerBrush}"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Width="28"
                                    Height="28"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    ToolTip="Close settings"
                                    Style="{StaticResource NitroButton}"
                                    Click="OnCloseSettingsClicked">
                                <Viewbox Width="11" Height="11">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 18,6 L 6,18 M 6,6 L 18,18"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="2.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Margin="2,0,0,6"
                                       Text="TASKBAR DISPLAY"
                                       FontFamily="{StaticResource NitroFont}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"/>

                            <Border Padding="11,10"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU graph"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource NitroFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="CpuHistoryButton" Content="History" Tag="History" Style="{StaticResource NitroChip}" Click="OnCpuModeClicked"/>
                                            <Button x:Name="CpuCoresButton" Margin="4,0,0,0" Content="Cores" Tag="Cores" Style="{StaticResource NitroChip}" Click="OnCpuModeClicked"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="RAM readout"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource NitroFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="RamPercentButton" Content="%" Tag="Percent" Style="{StaticResource NitroChip}" Click="OnRamModeClicked"/>
                                            <Button x:Name="RamGigabytesButton" Margin="4,0,0,0" Content="GB" Tag="Gigabytes" Style="{StaticResource NitroChip}" Click="OnRamModeClicked"/>
                                            <Button x:Name="RamBothButton" Margin="4,0,0,0" Content="% + GB" Tag="Both" Style="{StaticResource NitroChip}" Click="OnRamModeClicked"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Keep Awake"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource NitroFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="BarBadgeButton" Content="Badge" Tag="Badge" Style="{StaticResource NitroChip}" Click="OnBarModeClicked"/>
                                            <Button x:Name="BarIconButton" Margin="4,0,0,0" Content="Icon" Tag="CompactIcon" Style="{StaticResource NitroChip}" Click="OnBarModeClicked"/>
                                            <Button x:Name="BarHiddenButton" Margin="4,0,0,0" Content="Hide" Tag="Hidden" Style="{StaticResource NitroChip}" Click="OnBarModeClicked"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Auto Quiet"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource NitroFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button x:Name="AutoTemp70Button" Content="70°C" Tag="70" Style="{StaticResource NitroChip}" Click="OnAutoThresholdClicked"/>
                                            <Button x:Name="AutoTemp75Button" Margin="4,0,0,0" Content="75°C" Tag="75" Style="{StaticResource NitroChip}" Click="OnAutoThresholdClicked"/>
                                            <Button x:Name="AutoTemp80Button" Margin="4,0,0,0" Content="80°C" Tag="80" Style="{StaticResource NitroChip}" Click="OnAutoThresholdClicked"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="2,12,2,6">
                                <TextBlock Text="SYSTEM &amp; UPDATES"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="VersionText"
                                           HorizontalAlignment="Right"
                                           Text="v0.1.0"
                                           FontFamily="{StaticResource NitroFont}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>

                            <Border Padding="11,10"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Start with Windows"
                                                   FontFamily="{StaticResource NitroFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <ToggleButton x:Name="StartupToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource NitroToggle}"
                                                      Checked="OnStartupChanged"
                                                      Unchecked="OnStartupChanged"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Check updates automatically"
                                                   FontFamily="{StaticResource NitroFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <ToggleButton x:Name="AutomaticUpdatesToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource NitroToggle}"
                                                      Checked="OnAutomaticUpdatesChanged"
                                                      Unchecked="OnAutomaticUpdatesChanged"/>
                                    </Grid>

                                    <Button Margin="0,10,0,0"
                                            Padding="10,6"
                                            Content="Check for updates"
                                            Style="{StaticResource NitroButton}"
                                            Click="OnCheckUpdatesClicked"/>

                                    <TextBlock x:Name="UpdateStatusText"
                                               Margin="0,7,0,0"
                                               Visibility="Collapsed"
                                               Text=""
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource NitroFont}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="3"
                                Margin="0,12,0,0"
                                Padding="10,7"
                                Background="#1AF3A683"
                                BorderBrush="#3DF3A683"
                                Style="{StaticResource NitroButton}"
                                Click="OnQuitClicked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
