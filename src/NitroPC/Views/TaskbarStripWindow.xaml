<Window x:Class="NitroPC.Views.TaskbarStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NitroPC.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Width"
        Height="48">
    <Border x:Name="RootBorder"
            Height="36"
            Opacity="0"
            VerticalAlignment="Center"
            CornerRadius="7"
            Padding="10,0"
            Background="{StaticResource StripBackgroundBrush}"
            BorderBrush="{StaticResource StripBorderBrush}"
            BorderThickness="1"
            Cursor="Hand">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource StripHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:CpuBarsControl x:Name="CpuBars"
                                          Width="44"
                                          Height="22"
                                          MaxBars="20"
                                          BarBrush="{StaticResource CpuCoralBrush}"
                                          LatestBarBrush="{StaticResource CpuLatestBrush}"
                                          VerticalAlignment="Center"/>
                <Grid Margin="7,0,0,0" Width="32" Height="24" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="9"
                               FontWeight="Bold"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="10"
                               VerticalAlignment="Top"
                               TextAlignment="Left"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="CpuValue"
                               Grid.Row="1"
                               Text="0%"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="14"
                               VerticalAlignment="Bottom"
                               Typography.NumeralAlignment="Tabular"
                               TextAlignment="Left"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
                <Grid x:Name="CpuSensorPanel"
                      Margin="6,0,0,0"
                      Width="54"
                      Height="24"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CpuTempValue"
                               Text="—°C"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="9"
                               FontWeight="Bold"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="10"
                               VerticalAlignment="Top"
                               Typography.NumeralAlignment="Tabular"
                               TextAlignment="Left"
                               Foreground="#FFD6E2E8"/>
                    <TextBlock x:Name="CpuFreqValue"
                               Grid.Row="1"
                               Text="— GHz"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="14"
                               VerticalAlignment="Bottom"
                               Typography.NumeralAlignment="Tabular"
                               TextAlignment="Left"
                               Foreground="#FFBFD0D8"/>
                </Grid>
            </StackPanel>

            <Border Width="1"
                    Height="20"
                    Margin="9,0,9,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource DividerBrush}"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:RamSparklineControl x:Name="RamSparkline"
                                               Width="42"
                                               Height="22"
                                               MaxSamples="20"
                                               StrokeBrush="{StaticResource RamBlueBrush}"
                                               FillBrush="{StaticResource RamFillBrush}"
                                               GuideBrush="{StaticResource SparkGuideBrush}"
                                               LatestPointBrush="{StaticResource RamLatestBrush}"
                                               VerticalAlignment="Center"/>
                <Grid x:Name="RamValuePanel"
                      Margin="7,0,0,0"
                      Width="32"
                      Height="24"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RAM"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="9"
                               FontWeight="Bold"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="10"
                               VerticalAlignment="Top"
                               TextAlignment="Left"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="RamValue"
                               Grid.Row="1"
                               Text="0%"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="14"
                               VerticalAlignment="Bottom"
                               Typography.NumeralAlignment="Tabular"
                               TextAlignment="Left"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </StackPanel>

            <Border x:Name="KeepAwakeDivider"
                    Width="1"
                    Height="20"
                    Margin="9,0,9,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource DividerBrush}"/>

            <Border x:Name="KeepAwakeBadge"
                    Height="28"
                    Padding="7,0"
                    VerticalAlignment="Center"
                    CornerRadius="5"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="KeepAwakeIconPath"
                                  Data="M 17,8 H 18 A 4,4 0 1 1 18,16 H 17 M 3,8 H 17 V 17 A 4,4 0 0 1 13,21 H 7 A 4,4 0 0 1 3,17 Z M 6,2 V 4 M 10,2 V 4 M 14,2 V 4"
                                  Stroke="{StaticResource KaffeIdleIconBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <Grid x:Name="KeepAwakeText"
                          Margin="6,0,0,0"
                          Width="48"
                          Height="24"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KeepAwakeLabel"
                                   Text="IDLE"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="10"
                                   VerticalAlignment="Top"
                                   TextAlignment="Left"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="KeepAwakeValue"
                                   Grid.Row="1"
                                   Text="Off"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="14"
                                   VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular"
                                   TextAlignment="Left"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
