<Window x:Class="NitroPC.Views.TaskbarStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NitroPC.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Width"
        Height="48">
    <Border x:Name="RootBorder"
            Height="36"
            VerticalAlignment="Center"
            CornerRadius="7"
            Padding="10,0"
            Background="{StaticResource StripBackgroundBrush}"
            BorderBrush="{StaticResource StripBorderBrush}"
            BorderThickness="1"
            Cursor="Hand">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource StripHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <controls:CpuBarsControl x:Name="CpuBars"
                                          Width="50"
                                          Height="18"
                                          MaxBars="24"
                                          BarBrush="{StaticResource CpuCoralBrush}"
                                          LatestBarBrush="{StaticResource CpuLatestBrush}"
                                          VerticalAlignment="Bottom"/>
                <StackPanel Margin="7,0,0,0" Width="36" VerticalAlignment="Bottom">
                    <TextBlock Text="CPU"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="CpuValue"
                               Text="0%"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               TextAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <Border Width="1"
                    Height="20"
                    Margin="0,0,10,0"
                    Background="{StaticResource DividerBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <controls:RamSparklineControl x:Name="RamSparkline"
                                               Width="44"
                                               Height="20"
                                               StrokeBrush="{StaticResource RamBlueBrush}"
                                               FillBrush="{StaticResource RamFillBrush}"
                                               GuideBrush="{StaticResource SparkGuideBrush}"
                                               VerticalAlignment="Bottom"/>
                <StackPanel x:Name="RamValuePanel"
                            Margin="7,0,0,0"
                            Width="36"
                            VerticalAlignment="Bottom">
                    <TextBlock Text="RAM"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="RamValue"
                               Text="0%"
                               FontFamily="{StaticResource NitroFont}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               TextAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="KeepAwakeDivider"
                    Width="1"
                    Height="20"
                    Margin="0,0,10,0"
                    Background="{StaticResource DividerBrush}"/>

            <Border x:Name="KeepAwakeBadge"
                    Padding="6,3"
                    CornerRadius="6"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="KeepAwakeIconPath"
                                  Data="M 17,8 H 18 A 4,4 0 1 1 18,16 H 17 M 3,8 H 17 V 17 A 4,4 0 0 1 13,21 H 7 A 4,4 0 0 1 3,17 Z M 6,2 V 4 M 10,2 V 4 M 14,2 V 4"
                                  Stroke="{StaticResource KaffeIdleIconBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel x:Name="KeepAwakeText" Width="46" VerticalAlignment="Bottom">
                        <TextBlock x:Name="KeepAwakeLabel"
                                   Text="IDLE"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="8.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="KeepAwakeValue"
                                   Text="Off"
                                   FontFamily="{StaticResource NitroFont}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Typography.NumeralAlignment="Tabular"
                                   TextAlignment="Left"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
